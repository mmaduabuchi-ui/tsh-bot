# Meta WhatsApp Cloud API
WHATSAPP_TOKEN=paste_your_meta_permanent_token_here
WHATSAPP_PHONE_ID=paste_your_phone_number_id_here
WHATSAPP_VERIFY_TOKEN=choose_any_random_string_here
GRAPH_API_VERSION=v20.0

# AI brain (Groq - free tier)
GROQ_API_KEY=paste_your_groq_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Your number, to get notified when a lead comes in (optional, can leave blank for now)
OWNER_WHATSAPP_NUMBER=

PORT=3000
